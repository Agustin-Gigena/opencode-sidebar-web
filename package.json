{
  "name": "opencode-sidebar-web",
  "displayName": "OpenCode Sidebar Web",
  "description": "Integra la interfaz web de OpenCode en un panel lateral derecho de VS Code.",
  "version": "0.7.1",
  "publisher": "agustin-gigena",
  "repository": {
    "type": "git",
    "url": "https://github.com/agustin-gigena/opencode-sidebar-web"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/icon.png",
  "categories": [
    "Other",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:opencode-sidebar-web.openPanel",
    "onCommand:opencode-sidebar-web.startServer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencode-sidebar-web",
          "title": "OpenCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "opencode-sidebar-web": [
        {
          "type": "webview",
          "id": "opencode-sidebar-web.view",
          "name": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode-sidebar-web.openPanel",
        "title": "OpenCode: Abrir panel",
        "icon": {
          "light": "media/icon.svg",
          "dark": "media/icon.svg"
        }
      },
      {
        "command": "opencode-sidebar-web.closePanel",
        "title": "OpenCode: Cerrar panel",
        "icon": {
          "light": "media/icon-close.svg",
          "dark": "media/icon-close.svg"
        }
      },
      {
        "command": "opencode-sidebar-web.startServer",
        "title": "OpenCode: Iniciar servidor"
      },
      {
        "command": "opencode-sidebar-web.stopServer",
        "title": "OpenCode: Detener servidor"
      },
      {
        "command": "opencode-sidebar-web.restartServer",
        "title": "OpenCode: Reiniciar servidor"
      },
      {
        "command": "opencode-sidebar-web.openFile",
        "title": "OpenCode: Abrir archivo"
      },
      {
        "command": "opencode-sidebar-web.focusPanel",
        "title": "OpenCode: Enfocar panel"
      },
      {
        "command": "opencode-sidebar-web.installBinary",
        "title": "OpenCode: Instalar binario opencode"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencode-sidebar-web.openPanel",
          "group": "navigation",
          "when": "!config.opencode-sidebar-web.hideButton"
        }
      ],
      "view/title": [
        {
          "command": "opencode-sidebar-web.startServer",
          "when": "view == opencode-sidebar-web.view && !opencodeSidebarServerRunning",
          "group": "navigation"
        },
        {
          "command": "opencode-sidebar-web.stopServer",
          "when": "view == opencode-sidebar-web.view && opencodeSidebarServerRunning",
          "group": "navigation"
        },
        {
          "command": "opencode-sidebar-web.restartServer",
          "when": "view == opencode-sidebar-web.view && opencodeSidebarServerRunning",
          "group": "navigation"
        },
        {
          "command": "opencode-sidebar-web.installBinary",
          "when": "view == opencode-sidebar-web.view && !opencodeSidebarBinaryInstalled",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode-sidebar-web.openPanel",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o"
      }
    ],
    "configuration": {
      "title": "OpenCode Sidebar Web",
      "properties": {
        "opencode-sidebar-web.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Iniciar automáticamente el servidor OpenCode al abrir VS Code"
        },
        "opencode-sidebar-web.hostname": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Hostname para el servidor OpenCode"
        },
        "opencode-sidebar-web.hideButton": {
          "type": "boolean",
          "default": false,
          "description": "Ocultar el botón de OpenCode en la barra del editor"
        },
        "opencode-sidebar-web.autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "Reintentar conexión automáticamente cuando el servidor se cae"
        },
        "opencode-sidebar-web.maxReconnectAttempts": {
          "type": "number",
          "default": 3,
          "description": "Número máximo de intentos de reconexión"
        },
        "opencode-sidebar-web.sidebarPosition": {
          "type": "string",
          "default": "right",
          "enum": [
            "right"
          ],
          "description": "OpenCode siempre aparece en el secondary sidebar (lado derecho). Esta opción se mantiene por compatibilidad."
        },
        "opencode-sidebar-web.devcontainerMode": {
          "type": "boolean",
          "default": true,
          "description": "Detectar automáticamente opencode corriendo en el devcontainer/remoto"
        },
        "opencode-sidebar-web.autoInstallInDevcontainer": {
          "type": "boolean",
          "default": true,
          "description": "Instalar automáticamente opencode al activarse en un devcontainer si no está presente"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "esbuild": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify --sourcemap",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "opencode-ai": "^1.15.10"
  }
}
