{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "ralph": {
      "description": "Hands-off agent for usage with Ralph Loops",
      "mode": "primary",
      "reasoningEffort": "high",
      "tools": {
        "web-search_*": false
      },
      "permission": {
        "edit": {
          "opencode.jsonc": "deny",
          "ralph.toml": "deny",
          "logs/*": "deny"
        }
      }
    },
    "plan": {
      "description": "Plan writer agent for Ralph Loops — generates/updates IMPLEMENTATION_PLAN.md",
      "mode": "primary",
      "reasoningEffort": "high",
      "tools": {
        "web-search_*": false
      },
      "permission": {
        "edit": {
          "opencode.jsonc": "deny",
          "ralph.toml": "deny",
          "ralph-local.toml": "deny",
          "logs/*": "deny"
        }
      }
    }
  },
  "permission": {
    "edit": {
      "logs/*": "deny"
    }
  }
}
